# --- Database ---
DATABASE_URL="postgresql://aecoach:aecoach@localhost:5432/aecoach?schema=public"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="run: openssl rand -base64 32"

# --- Grok (xAI) ---
# Get a key from https://x.ai/api
GROK_API_KEY="xai-..."
# Synth tier — used for intake synthesis, monthly reviews, recommendations.
# Per-org override possible via Org.aiModel column. Valid xAI models (2026):
#   grok-4-latest, grok-4-fast-reasoning, grok-4-fast-non-reasoning,
#   grok-3, grok-3-mini, grok-code-fast-1
GROK_MODEL="grok-4-fast-reasoning"
# Fast tier — always used for cleanup ops (classify, enhance, extract, etc.).
# Stays cheap regardless of synth-tier choice.
GROK_MODEL_FAST="grok-3-mini"
GROK_BASE_URL="https://api.x.ai/v1"

# --- App ---
APP_URL="http://localhost:3000"
PROD_HOST="portal.benjohnson.ai"

# --- Email (for invite links) ---
# v0 logs invite link to console; wire SMTP for prod.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AE Coach <noreply@benjohnson.ai>"

# --- Files ---
FILES_DIR="./uploads"

# --- Cron ---
# Shared secret the docker-compose cron sidecar uses to hit /api/cron/* endpoints.
# Generate with: openssl rand -base64 32
CRON_SECRET="run: openssl rand -base64 32"
